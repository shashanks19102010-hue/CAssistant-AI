NODE_ENV=development

CASSISTANT_DATA_DIR=.cassistant
CASSISTANT_SERVER_HOST=127.0.0.1
CASSISTANT_SERVER_PORT=3000
CASSISTANT_LOCAL_ONLY=true
CASSISTANT_ALLOW_REMOTE_AI=false
CASSISTANT_ALLOW_REMOTE_RESEARCH=true
CASSISTANT_TELEMETRY=false
CASSISTANT_BACKGROUND_JOBS=true
CASSISTANT_MAX_UPLOAD_MB=100
CASSISTANT_MAX_CONCURRENT_JOBS=2
CASSISTANT_DEFAULT_CHAT_MODEL=qwen3:4b
CASSISTANT_LOCAL_AI_URL=http://127.0.0.1:11434
CASSISTANT_IMAGE_ENGINE_URL=http://127.0.0.1:8188
CASSISTANT_VIDEO_ENGINE_URL=
CASSISTANT_AUDIO_ENGINE_URL=
CASSISTANT_3D_ENGINE_URL=
CASSISTANT_BLENDER_PATH=blender
CASSISTANT_FFMPEG_PATH=ffmpeg
CASSISTANT_LOCAL_RESEARCH_URL=
CASSISTANT_SEARCH_ENDPOINT=
CASSISTANT_SEARCH_KEY=
